    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\nconst allowedTypes = [\n  'preference',\n  'decision',\n  'commitment',\n  'fact'\n];\n\n// Validate and normalize inputs\nconst userId = String(input.user_id || '').trim();\nconst sessionId = String(input.session_id || '').trim();\n\nconst memoryType = String(input.memory_type || '')\n  .trim()\n  .toLowerCase();\n\nconst memoryText = String(input.memory_text || '').trim();\n\nconst memoryKey = String(input.memory_key || '')\n  .trim()\n  .toLowerCase()\n  .replace(/[^a-z0-9_]+/g, '_')\n  .replace(/^_+|_+$/g, '');\n\n// Validate required fields\nif (\n  !userId ||\n  !sessionId ||\n  !allowedTypes.includes(memoryType) ||\n  !memoryKey ||\n  !memoryText ||\n  memoryText.length > 1000\n) {\n  return [{\n    json: {\n      valid: false,\n      success: false,\n      message: 'Invalid memory information. Check required fields, memory type, key, and text length.'\n    }\n  }];\n}\n\n// Unique identifier for each user's memory subject\nconst lookupKey = `${userId}:${memoryKey}`;\n\n// Unique ID for newly inserted records\nconst memoryId = `MEM-${Date.now()}`;\n\n// Pakistan date and time\nconst now = $now\n  .setZone('Asia/Karachi')\n  .toFormat('dd MM yyyy HH:mm');\n\nreturn [{\n  json: {\n    valid: true,\n    memory_id: memoryId,\n    lookup_key: lookupKey,\n    user_id: userId,\n    session_id: sessionId,\n    memory_key: memoryKey,\n    memory_type: memoryType,\n    memory_text: memoryText,\n    created_at: now,\n    updated_at: now\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
